{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native source coordinate attempt, not musical truth",
  "type": "object", "additionalProperties": false,
  "required": ["schema_name", "schema_version", "producer_version", "record_id", "record_sha256", "source_statement_ref", "source_sha256", "native_tag", "binding", "status", "reasons", "endpoints", "literal_pitch_token", "semantics", "use_policy"],
  "properties": {
    "schema_name": {"const": "musicanote-musical-semantic-alignment"}, "schema_version": {"const": "0.1.0"},
    "producer_version": {"const": "musical-semantic-alignment-0.1.1"},
    "record_id": {"type": "string", "pattern": "^msa_[0-9a-f]{24}$"}, "record_sha256": {"$ref": "#/$defs/hash"},
    "source_statement_ref": {"type": "object", "additionalProperties": false, "required": ["record_id", "record_sha256"], "properties": {"record_id": {"type": "string"}, "record_sha256": {"$ref": "#/$defs/hash"}}},
    "source_sha256": {"$ref": "#/$defs/hash"}, "native_tag": {"enum": ["Note", "Form", "Pedal"]},
    "status": {"enum": ["exact_coordinate", "deferred"]},
    "literal_pitch_token": {"type": ["string", "null"]},
    "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "endpoints": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["printed_measure_number", "measure_id", "sequential_measure_index", "source_beat_literal", "source_meter", "source_beat_spans_quarter", "local_quarter", "global_quarter"],
      "properties": {
        "printed_measure_number": {"type": "string"}, "measure_id": {"type": "string"}, "sequential_measure_index": {"type": "integer", "minimum": 0},
        "source_beat_literal": {"type": "string"}, "source_meter": {"type": "string"},
        "source_beat_spans_quarter": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}},
        "local_quarter": {"$ref": "#/$defs/q"}, "global_quarter": {"$ref": "#/$defs/q"}
      }
    }},
    "binding": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["score_id", "ir_document_id", "ir_content_sha256", "source_files", "target_span"],
      "properties": {"score_id": {"type": "string"}, "ir_document_id": {"type": "string"}, "ir_content_sha256": {"$ref": "#/$defs/hash"},
        "source_files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["source_file_id", "sha256", "musicxml_version", "original_name"], "properties": {
            "source_file_id": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}, "musicxml_version": {"type": ["string", "null"]}, "original_name": {"type": "string"}
          }}},
        "target_span": {"$ref": "#/$defs/span"}
      }
    }]},
    "semantics": {"const": {"coordinate_only": true, "pedal_lane_identified": false, "musical_role_validated": false, "end_exclusive": true}},
    "use_policy": {"const": {"research_only": true, "training_eligible": false, "gold_status": "not_established"}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "exact_coordinate"}}}, "then": {"properties": {"native_tag": {"const": "Pedal"}, "binding": {"type": "object"}, "reasons": {"maxItems": 0}, "endpoints": {"minItems": 2, "maxItems": 2}, "literal_pitch_token": {"type": "string"}}}},
    {"if": {"properties": {"status": {"const": "deferred"}}}, "then": {"properties": {"binding": {"type": "null"}, "reasons": {"minItems": 1}, "endpoints": {"maxItems": 0}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "q": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}},
    "span": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"$ref": "#/$defs/q"}, "end": {"$ref": "#/$defs/q"}}}
  }
}
