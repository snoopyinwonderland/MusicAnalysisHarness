{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.musicanote.com/musical-harmony-assumption/0.1.0",
  "title": "Research-only harmony hypothesis, not gold or an automatic winner",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "producer_version", "record_id", "record_sha256", "binding", "provenance", "segments", "coverage_holes", "import_diagnostics", "use_policy"],
  "properties": {
    "schema_name": {"const": "musicanote-musical-harmony-assumption"},
    "schema_version": {"const": "0.1.0"},
    "producer_version": {"const": "musical-harmony-assumption-0.1.0"},
    "record_id": {"type": "string", "pattern": "^mha_[0-9a-f]{24}$"},
    "record_sha256": {"$ref": "#/$defs/hash"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["score_id", "ir_document_id", "ir_content_sha256", "source_files"],
      "properties": {
        "score_id": {"type": "string", "minLength": 1},
        "ir_document_id": {"type": "string", "minLength": 1},
        "ir_content_sha256": {"$ref": "#/$defs/hash"},
        "source_files": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/sourceFile"}}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "engine_version", "source_document_sha256", "source_path", "pitch_basis", "status"],
      "allOf": [{
        "if": {"required": ["kind"], "properties": {"kind": {"const": "source_annotation"}}},
        "then": {"properties": {
          "source_document_sha256": {"$ref": "#/$defs/hash"},
          "source_path": {"type": "string", "minLength": 1}
        }}
      }],
      "properties": {
        "kind": {"enum": ["caller_hypothesis", "source_annotation"]},
        "engine_version": {"type": "string", "minLength": 1},
        "source_document_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "source_path": {"type": ["string", "null"], "minLength": 1},
        "pitch_basis": {"const": "written_IR_not_concert_certified"},
        "status": {"const": "hypothesis_not_gold"}
      }
    },
    "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
    "coverage_holes": {"type": "array", "description": "Half-open score intervals lacking a usable hypothesis, including blocked spans.", "items": {"$ref": "#/$defs/span"}},
    "import_diagnostics": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "label", "printed_measure_number", "source_locator", "local_span", "blockers"],
      "properties": {
        "status": {"const": "held"},
        "label": {"type": ["string", "null"]},
        "printed_measure_number": {"type": ["string", "null"]},
        "source_locator": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locator"}]},
        "local_span": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/span"}]},
        "blockers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }},
    "use_policy": {"const": {"research_only": true, "training_eligible": false, "gold_status": "not_established", "generation_ready": false}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rational": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}},
    "span": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"$ref": "#/$defs/rational"}, "end": {"$ref": "#/$defs/rational"}}},
    "pitch": {"type": "object", "additionalProperties": false, "required": ["step", "alter"], "properties": {"step": {"enum": ["A", "B", "C", "D", "E", "F", "G"]}, "alter": {"$ref": "#/$defs/rational"}}},
    "locator": {"type": "object", "additionalProperties": false, "required": ["printed_measure_number", "line_number", "raw_line"], "properties": {"printed_measure_number": {"type": "string", "minLength": 1}, "line_number": {"type": ["integer", "null"], "minimum": 1}, "raw_line": {"type": ["string", "null"]}}},
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["segment_id", "span", "label", "root", "members", "status", "blockers", "source_locator"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1},
        "span": {"$ref": "#/$defs/span"},
        "label": {"type": "string", "minLength": 1},
        "root": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/pitch"}]},
        "members": {"type": "array", "items": {"$ref": "#/$defs/pitch"}},
        "status": {"enum": ["usable", "blocked"]},
        "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_locator": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/locator"}]}
      }
    }
  }
}
