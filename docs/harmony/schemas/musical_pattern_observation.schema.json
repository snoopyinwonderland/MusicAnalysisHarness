{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.musicanote.com/musical-pattern-observation/0.1.0",
  "title": "Literal pattern observation, not an arrangement template",
  "type": "object",
  "required": ["schema_name", "schema_version", "producer_version", "record_id", "record_sha256", "scope", "slots", "core_projection", "raw_lanes", "semantics", "use_policy"],
  "additionalProperties": false,
  "properties": {
    "schema_name": {"const": "musicanote-musical-pattern-observation"},
    "schema_version": {"const": "0.1.0"},
    "producer_version": {"const": "musical-pattern-observation-0.1.0"},
    "record_id": {"type": "string", "pattern": "^mpo_[0-9a-f]{24}$"},
    "record_sha256": {"$ref": "#/$defs/hash"},
    "scope": {"type": "object", "additionalProperties": false,
      "required": ["case_id", "score_id", "ir_document_id", "ir_content_sha256", "source_files", "source_statement_ref", "alignment_ref", "target_span", "context_span"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "score_id": {"type": "string", "minLength": 1},
        "ir_document_id": {"type": "string", "minLength": 1},
        "ir_content_sha256": {"$ref": "#/$defs/hash"},
        "source_files": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/sourceFile"}},
        "source_statement_ref": {"$ref": "#/$defs/ref"},
        "alignment_ref": {"$ref": "#/$defs/ref"},
        "target_span": {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/span"},
        "context_span": {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/span"}
      }
    },
    "slots": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["event_id", "event_kind", "relative_onset_quarter", "target_relation", "context_relation", "target_overlap", "core_event"],
      "properties": {
        "event_id": {"type": "string"}, "event_kind": {"enum": ["note", "rest"]},
        "relative_onset_quarter": {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/rational"},
        "target_relation": {"$ref": "#/$defs/relation"}, "context_relation": {"$ref": "#/$defs/relation"},
        "target_overlap": {"oneOf": [{"type": "null"}, {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/span"}]},
        "core_event": {"oneOf": [{"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/note"}, {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/rest"}]}
      }
    }},
    "raw_lanes": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["part_id", "voice_id", "event_ids"],
      "properties": {"part_id": {"type": "string"}, "voice_id": {"type": "string"}, "event_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}
    }},
    "core_projection": {"type": "object", "additionalProperties": false,
      "required": ["source_files", "source_references", "parts", "staves", "voices", "measures", "sounding_events", "tie_chains", "attack_events", "chord_onset_groups", "parser_manifest"],
      "properties": {
        "source_files": {"type": "array", "items": {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/sourceFile"}},
        "source_references": {"type": "array", "items": {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/sourceRef"}},
        "parts": {"type": "array", "items": {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/part"}},
        "staves": {"type": "array", "items": {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/staff"}},
        "voices": {"type": "array", "items": {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/voice"}},
        "measures": {"type": "array", "items": {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/measure"}},
        "sounding_events": {"type": "array", "items": {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/sounding"}},
        "tie_chains": {"type": "array", "items": {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/tieChain"}},
        "attack_events": {"type": "array", "items": {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/attack"}},
        "chord_onset_groups": {"type": "array", "items": {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/chordGroup"}},
        "parser_manifest": {"$ref": "https://schemas.musicanote.com/canonical-music-ir/0.1.0#/$defs/parserManifest"}
      }
    },
    "semantics": {"const": {"kind": "literal_notated_observation", "roles_assigned": false, "chord_relative_degrees_assigned": false, "generation_ready": false, "catalog_refs": "original_full_document_not_fragment", "pitch_basis": "original_IR_not_independent_concert_pitch_certification"}},
    "use_policy": {"const": {"research_only": true, "training_eligible": false, "gold_status": "not_established"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["record_id", "record_sha256"], "properties": {"record_id": {"type": "string", "minLength": 1}, "record_sha256": {"$ref": "#/$defs/hash"}}},
    "relation": {"enum": ["overlap", "point_inside", "linked_context_only"]}
  }
}
