{
  "name": "musicanote-similarity-search-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:score-tools": "vite build --config vite.score-tools.config.ts && tsc -p tsconfig.score-tools.json",
    "test:score-tools": "vitest run src/score-tools/model.test.ts src/score-tools/selectionTransform.test.ts src/score-tools/imageExport.test.ts src/score-tools/verovioLayout.integration.test.ts src/score-tools/verovioTransposition.integration.test.ts src/score-tools/publicApi.test.ts",
    "pack:score-tools": "pnpm run build:score-tools && pnpm --dir packages/verovio-score-tools pack",
    "eval": "vitest run src/search/evaluation.test.ts",
    "sync:music-analysis": "node scripts/sync-music-analysis.mjs",
    "youtube:backfill": "node scripts/youtube-backfill.mjs",
    "youtube:worker": "node scripts/youtube-backfill.mjs --watch",
    "index:musicxml": "python scripts/build-musicxml-search-index.py",
    "index:musicxml:sample": "python scripts/build-musicxml-search-index.py --limit 25",
    "index:finalize": "node scripts/finalize-search-index.mjs",
    "index:sqlite": "node scripts/build-search-sqlite.mjs",
    "harness:export": "node scripts/export-evaluation-cases.mjs",
    "harness:capture-context": "node scripts/capture-evaluation-context.mjs",
    "harness:capture-motif-contexts": "node scripts/capture-motif-contexts.mjs",
    "harness:phrase": "node scripts/evaluate-phrase-search.mjs --variant both --output evaluation/runs/phrase-context-latest.json",
    "harness:import-query-100": "node scripts/import-query-100-report.mjs",
    "harness:motif-100": "node scripts/motif-100-benchmark.mjs all"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "verovio": "6.3.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@xmldom/xmldom": "0.9.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
