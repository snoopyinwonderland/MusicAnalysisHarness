{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musicanote.local/schema/query-case.schema.json",
  "title": "MUSICANOTE Query Evaluation Case",
  "type": "object",
  "required": ["schema", "caseId", "createdAt", "status", "query", "expected", "observations", "diagnoses", "proposals", "runs"],
  "properties": {
    "schema": { "const": "musicanote-evaluation-case/v1" },
    "caseId": { "type": "string" },
    "createdAt": { "type": "string", "format": "date" },
    "status": { "enum": ["draft", "diagnosed", "verified", "resolved"] },
    "query": { "type": "object" },
    "expected": { "type": "object" },
    "observations": { "type": "array", "items": { "type": "object" } },
    "diagnoses": { "type": "array", "items": { "type": "object" } },
    "proposals": { "type": "array", "items": { "type": "object" } },
    "runs": { "type": "array", "items": { "type": "object" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "knowledgeBase": {
      "type": "object",
      "required": ["schema", "identity", "sourceSnapshot", "focus", "context", "assets", "classification", "ruleLearning"],
      "properties": {
        "schema": { "const": "musicanote-case-knowledge/v1" },
        "status": { "type": "string" },
        "capturedAt": { "type": "string" },
        "identity": { "type": "object" },
        "sourceSnapshot": { "type": "object" },
        "focus": { "type": "object" },
        "context": { "type": "object" },
        "assets": {
          "type": "object",
          "required": ["musicXml", "events"],
          "properties": { "musicXml": { "type": "string" }, "events": { "type": "string" } },
          "additionalProperties": true
        },
        "classification": {
          "type": "object",
          "required": ["phenomenonTypes", "musicalFunctions", "contextualConditions", "exclusions"],
          "properties": {
            "phenomenonTypes": { "type": "array" },
            "musicalFunctions": { "type": "array" },
            "contextualConditions": { "type": "array" },
            "exclusions": { "type": "array" },
            "confidence": { "type": "string" }
          },
          "additionalProperties": true
        },
        "ruleLearning": {
          "type": "object",
          "required": ["candidateRules", "counterexamples", "reusableFor"],
          "properties": {
            "candidateRules": { "type": "array" },
            "counterexamples": { "type": "array" },
            "reusableFor": { "type": "array" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
