{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MUSICANOTE source annotation alignment 0.1.0",
  "type": "object",
  "required": ["alignment_id", "annotation_id", "ir_document_id", "mapping_status", "method_version", "measure_id", "target", "sounding_event_ids", "attacked_sounding_event_ids", "diagnostics"],
  "properties": {
    "alignment_id": {"type": "string", "minLength": 1},
    "annotation_id": {"type": "string", "minLength": 1},
    "ir_document_id": {"type": "string", "minLength": 1},
    "mapping_status": {"enum": ["exact", "verified_transform", "ambiguous", "orphaned", "unsupported"]},
    "method_version": {"type": "string", "minLength": 1},
    "measure_id": {"type": ["string", "null"]},
    "target": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/target"}]},
    "sounding_event_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "attacked_sounding_event_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "rational": {"type": "object", "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "span": {"type": "object", "required": ["start", "end"], "properties": {"start": {"$ref": "#/$defs/rational"}, "end": {"$ref": "#/$defs/rational"}}, "additionalProperties": false},
    "target": {"type": "object", "required": ["score_id", "ir_document_id"], "oneOf": [{"required": ["span"]}, {"required": ["point"]}], "properties": {"score_id": {"type": "string"}, "ir_document_id": {"type": "string"}, "span": {"$ref": "#/$defs/span"}, "point": {"$ref": "#/$defs/rational"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
