{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MUSICANOTE RomanText source evidence 0.1.0",
  "type": "object",
  "required": ["schema_name", "schema_version", "engine_version", "score_id", "ir_document_id", "input_policy", "interpretation", "summary", "records"],
  "properties": {
    "schema_name": {"const": "musicanote-romantext-source-evidence"},
    "schema_version": {"const": "0.1.0"},
    "engine_version": {"type": "string"},
    "score_id": {"type": "string"},
    "ir_document_id": {"type": "string"},
    "input_policy": {"const": "source_labels_visible_to_separate_evidence_scorer"},
    "interpretation": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["record_count", "support_band_counts"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 0},
        "support_band_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["annotation_id", "raw_label", "key_raw", "mapping_status", "status", "support_band", "diagnostics"],
        "properties": {
          "annotation_id": {"type": "string"},
          "raw_label": {"type": "string"},
          "key_raw": {"type": "string"},
          "mapping_status": {"type": "string"},
          "status": {"enum": ["scored", "unscorable"]},
          "support_band": {"enum": ["strong_support", "moderate_support", "mixed_evidence", "weak_evidence", "unscorable"]},
          "diagnostics": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
