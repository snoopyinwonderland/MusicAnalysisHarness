{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MUSICANOTE RomanText contextual evidence 0.1.0",
  "type": "object",
  "required": ["schema_name", "schema_version", "engine_version", "score_id", "ir_document_id", "input_policy", "interpretation", "summary", "records"],
  "properties": {
    "schema_name": {"const": "musicanote-romantext-context-evidence"},
    "schema_version": {"const": "0.1.0"},
    "engine_version": {"type": "string"},
    "score_id": {"type": "string"},
    "ir_document_id": {"type": "string"},
    "input_policy": {"const": "source_labels_visible_to_separate_context_evidence_scorer"},
    "interpretation": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["record_count", "scored_boundaries", "possible_nct_resolution_edges"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 0},
        "scored_boundaries": {"type": "integer", "minimum": 0},
        "possible_nct_resolution_edges": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["annotation_id", "raw_label", "previous_annotation_id", "previous_raw_label", "next_annotation_id", "next_raw_label", "status", "diagnostics"],
        "properties": {
          "annotation_id": {"type": "string"},
          "raw_label": {"type": "string"},
          "previous_annotation_id": {"type": ["string", "null"]},
          "previous_raw_label": {"type": ["string", "null"]},
          "next_annotation_id": {"type": ["string", "null"]},
          "next_raw_label": {"type": ["string", "null"]},
          "status": {"enum": ["scored", "unscorable", "no_next_context"]},
          "boundary_voice_leading_edges": {"type": "array"},
          "diagnostics": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
